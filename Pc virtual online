
class VirtualPC:
    def __init__(self, cpu, ram, storage, gpu):
        self.cpu = cpu
        self.ram = ram
        self.storage = storage
        self.gpu = gpu
        self.running = False

    def start(self):
        self.running = True
        print("\n=== PC VIRTUAL ===")
        print(f"CPU: {self.cpu}")
        print(f"GPU: {self.gpu}")
        print(f"RAM: {self.ram} GB")
        print(f"Armazenamento: {self.storage} GB")
        print("PC iniciado com sucesso!")

    def shutdown(self):
        self.running = False
        print("PC virtual desligado.")

    def info(self):
        print("\n--- ESPECIFICAÇÕES ---")
        print(f"CPU: {self.cpu}")
        print(f"GPU: {self.gpu}")
        print(f"RAM: {self.ram} GB")
        print(f"SSD: {self.storage} GB")


pc = VirtualPC(
    cpu="AMD Ryzen 7 7800X3D",
    gpu="NVIDIA GeForce RTX 4070 SUPER 12 GB",
    ram=32,
    storage=1000
)

while True:
    print("\n===== PC VIRTUAL =====")
    print("1 - Ligar")
    print("2 - Desligar")
    print("3 - Ver especificações")
    print("4 - Sair")

    escolha = input("Escolha: ")

    if escolha == "1":
        pc.start()
    elif escolha == "2":
        pc.shutdown()
    elif escolha == "3":
        pc.info()
    elif escolha == "4":
        break
    else:
        print("Opção inválida.")
