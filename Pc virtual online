class VirtualPC:
    def __init__(self):
        self.cpu = "AMD Ryzen 7 7800X3D"
        self.gpu = "NVIDIA GeForce RTX 4070 SUPER 12 GB"
        self.ram = "32 GB"
        self.storage = "1 TB SSD"
        self.ligado = False

    def ligar(self):
        if self.ligado:
            print("O PC já está ligado.")
        else:
            self.ligado = True
            print("\nPC virtual ligado com sucesso!")

    def desligar(self):
        if not self.ligado:
            print("O PC já está desligado.")
        else:
            self.ligado = False
            print("\nPC virtual desligado.")

    def especificacoes(self):
        print("\n===== ESPECIFICAÇÕES =====")
        print("CPU:", self.cpu)
        print("GPU:", self.gpu)
        print("RAM:", self.ram)
        print("Armazenamento:", self.storage)
        print("Status:", "Ligado" if self.ligado else "Desligado")


